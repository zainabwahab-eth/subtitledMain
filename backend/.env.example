DEEPL_API_KEY=your_deepl_key_here

# Free tier keys use the api-free.deepl.com endpoint.
# Paid keys use api.deepl.com. Set this to match your key type.
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

MONGODB_URI=mongodb://localhost:27017/yt-translator

SUPADATA_API_KEY=          # production only — leave empty for local dev

FRONTEND_ORIGIN=http://localhost:5173

# Path to python executable
PYTHON_PATH=python3
# Whisper model size: tiny | base | small | medium | large

WHISPER_MODEL=base